# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=3000

# Frontend origin (used for CORS and post-Google-login redirect)
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db>?retryWrites=true&w=majority

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Google Cloud Console -> APIs & Services -> Credentials
CLIENT_ID=
CLIENT_SECRET=
# Must exactly match an "Authorized redirect URI" in Google Console
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Gemma 4 via Google AI Studio (free, no card needed).
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Confirm the exact model ID in AI Studio; this is the default.
GEMMA_MODEL=gemma-4-31b-it
# Optional. Tried automatically if the main model keeps returning errors.
GEMMA_FALLBACK_MODEL=gemma-4-26b-a4b-it
